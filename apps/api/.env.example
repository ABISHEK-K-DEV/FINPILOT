# ───────────── FinPilot API environment ─────────────
# Copy to apps/api/.env and adjust. NEVER commit real secrets. See docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://finpilot:finpilot_dev@localhost:5432/finpilot?schema=public
# Used only by the API integration test-suite (required to run `npm test` in apps/api)
TEST_DATABASE_URL=postgresql://finpilot:finpilot_dev@localhost:5432/finpilot_test?schema=public

# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
WEB_ORIGINS=http://localhost:5173

# 32-byte key, base64-encoded, for AES-256-GCM field encryption (required).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Secret used to HMAC IP addresses in audit logs (required). Any long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HASH_SECRET=

# Session lifetime in days (default 14) and cookie name
SESSION_TTL_DAYS=14
SESSION_COOKIE_NAME=fp_session
# Set true behind HTTPS in production (forced true when NODE_ENV=production)
COOKIE_SECURE=false

# Set when running behind a reverse proxy / load balancer (number of trusted hops)
TRUST_PROXY=0

# Comma-separated emails that are promoted to ADMIN on registration/seed (optional)
ADMIN_EMAILS=

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Optional. Redis is NOT required for Milestone 1 (rate limiting uses in-memory storage).
# From Milestone 2 it backs rate limiting, OCR job queues and reminder workers.
REDIS_URL=
